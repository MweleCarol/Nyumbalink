# Copy this file to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4000

# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# If your password contains special characters, URL-encode them (for example @ becomes %40).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/nyumbalink_dev

# Comma-separated list of web origins allowed to call the API (not needed for the mobile app itself).
CORS_ORIGINS=